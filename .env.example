# Copy to .env.local for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables for production.

# ─── Site ────────────────────────────────────────────────────────────────────
# The public URL of the live site (no trailing slash). Used for SEO tags, the
# sitemap, and the logo/links inside emails.
NEXT_PUBLIC_SITE_URL=https://avdavey.com

# ─── Email (contact + quote forms) ───────────────────────────────────────────
# SMTP details from the email provider for davey@avdavey.com.
#   Google Workspace / Gmail: smtp.gmail.com, port 465, SMTP_SECURE=true,
#                             use an App Password (not the normal password)
#   Microsoft 365 / Outlook:  smtp.office365.com, port 587, SMTP_SECURE=false
#   Zoho:                     smtp.zoho.com, port 465, SMTP_SECURE=true
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=website@avdavey.com
SMTP_PASS=your-app-password

# Who the emails come from. Must be an address the SMTP account is allowed to send as.
MAIL_FROM="A/V DAVEY Website <website@avdavey.com>"

# Where new form submissions go (comma-separate for more than one person).
MAIL_TO=davey@avdavey.com

# Optional: a hidden copy of every submission (e.g. for the web developer).
# MAIL_BCC=

# Set to false to stop sending the automatic confirmation email to customers.
# MAIL_SEND_CONFIRMATION=true

# ─── Facebook feed on the homepage (optional) ───────────────────────────────
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
